# =====================================================================
# seek-harness environment — copy to .env and edit
#   cp .env.example .env
# =====================================================================

# ── Web UI / proxy ───────────────────────────────────────────────────
# Publish bind for the proxy port. 127.0.0.1 = local machine only (safe).
# 0.0.0.0 = LAN accessible — then ALWAYS set Basic Auth below.
DSH_BIND=127.0.0.1

# Proxy (public) port and DSH (internal loopback) port — must differ.
PROXY_PORT=3080
DSH_PORT=3079

# Optional HTTP Basic Auth (HTTP + WebSocket). Auth is enabled ONLY when
# BOTH are set. Strongly recommended if DSH_BIND=0.0.0.0.
PROXY_USERNAME=
PROXY_PASSWORD=

# REQUIRED for LAN access. DSH's /api browser-trust fence only accepts
# loopback by default; add your LAN authority (host[:port]) so the UI's /api
# calls (models, plugins, settings) work from another machine.
# Example: DSH_TRUSTED_HOSTS=192.168.0.6:3080
DSH_TRUSTED_HOSTS=192.168.0.6:3080   # LAN access: browser Origin authority for DSH /api fence

# ── Docker engine access (pick ONE) ──────────────────────────────────
# Option A — Docker proxy over TCP (preferred; e.g. a socket proxy):
#DOCKER_HOST=tcp://docker-socket-proxy:2375
# Option B — host docker.sock via the compose.docker.yaml override:
#   docker compose -f compose.yaml -f compose.docker.yaml up -d
# and set the host docker group gid (check on HOST: stat -c %g /var/run/docker.sock)
DOCKER_GID=999
# Option C — a FULL, ISOLATED engine in a sidecar (no host daemon at all):
#   docker compose -f compose.yaml -f compose.dind.yaml up -d
# The agent gets its own dockerd; nothing it builds, deploys or tests touches
# the host. DIND_DATA must be a REAL filesystem (ext4/xfs/btrfs) — overlay2
# refuses to sit on top of FUSE, so never point it at a mergerfs pool. Keep
# DIND_DATA, DIND_EXPORT and DIND_REGISTRY_DATA on the same disk as the
# host's own docker root if you can; DIND_EXPORT / DIND_REGISTRY_DATA are the
# two directories that SURVIVE a purge (they hold the finished images).
#DIND_DATA=/srv/<data-disk>/deepseek-harness-data/<stack>/dind
#DIND_EXPORT=/srv/<data-disk>/deepseek-harness-data/<stack>/image-export
#DIND_REGISTRY_DATA=/srv/<data-disk>/deepseek-harness-data/<stack>/dind-registry
# Option C hardened — run the engine under Sysbox (no privileges at all):
#   docker compose -f compose.yaml -f compose.dind.yaml -f compose.dind-sysbox.yaml up -d
# Requires Sysbox CE on the host (runtime sysbox-runc + its two services).
# Host pulls a finished image straight from the bundled registry — NO daemon.json
# change needed, because Docker treats 127.0.0.0/8 registries as insecure:
#   in the harness: docker tag myapp:1.0 registry:5000/myapp:1.0 && docker push registry:5000/myapp:1.0
#   on the host:    docker pull 127.0.0.1:5001/myapp:1.0
#DIND_REGISTRY_PORT=5001           # host loopback port for the registry (5000 is often taken)
#DIND_IMAGE_TAG=29-dind            # engine version for the sidecar
#DIND_NETWORK=harness-docker       # private network: harness + engine only
#DIND_CONTAINER_NAME=seek-harness-dind
#REGISTRY_CONTAINER_NAME=seek-harness-registry

# ── Workspace ────────────────────────────────────────────────────────
# Absolute path the agent operates on (bind-mounted to /workspace).
DSH_WORKSPACE=./workspace

# ── Model credentials (runtime secrets — never bake into the image) ──
# Can also be configured in the Web UI settings page instead.
DEEPSEEK_API_KEY=
# Optional OpenAI-compatible / search overrides:
#DEEPSEEK_BASE_URL=
#DEEPSEEK_SEARCH_BASE_URL=

# ── Upstream runtime knobs (empty = upstream defaults) ───────────────
# Telemetry: 1 = hard-disabled locally (seek-harness default), empty = upstream
DSH_TELEMETRY_DISABLED=1
# Permission preset fallback: read-only | workspace-write | danger-full-access
# Confined modes need the Landlock kernel sandbox (bundled launcher; Linux >=5.13
# with Landlock enabled — Debian 12+/Ubuntu 23+ yes, most NAS kernels no). If
# agent Bash fails with 'no sandbox backend is usable', use danger-full-access.
DSH_PERMISSION_MODE=
# Tools mode: native | ptc | both
DSH_TOOLS_MODE=
# Extra flags for the DSH main process only (default: --expose-internals)
#DSH_NODE_FLAGS=--expose-internals

# ── Office documents (dsh-office) ────────────────────────────────────
# Word / PowerPoint / Excel / PDF work for the model, built into the image: the
# harness's own office-* skills on the pinned Python payload, plus this image's
# pdf-documents skill and the bundled LibreOffice engine that renders pages to
# images (for a vision model) and converts to PDF. It appears in the Plugins page
# as a switchable card, next to the browser rows.
#   1 = a fresh home selects it once (recommended) · 0 = never select it
DSH_OFFICE=1
# Optional: a different payload directory (one holding runtime.json + dependencies/).
# Empty = the image's own /opt/dsh-office/primary-runtime.
#DSH_OFFICE_RUNTIME=

# ── Personal VM (cua) ────────────────────────────────────────────────
# The model's own Linux computer on /dev/kvm (compose.emulator.yaml), plus an
# optional Windows computer on a DinD engine (compose.windows.yaml). Manages
# itself from Plugins → Personal VM; these are switches, not settings.
#   1 = the VM tools are offered · 0 = no VM tools at all
DSH_CUA_VM=1
# Store volume (outside the workspace): base image, disks, checkpoints,
# screenshots and the Windows containers' storage.
CUA_VM_STORE=/cua-vm
# ── KVM device access (the mounted-but-denied failure) ────────────────
# `devices: - /dev/kvm` MOUNTS the node; it does not grant ACCESS to it. Docker
# passes the host node through with its own uid:gid, normally root:kvm 0660,
# while this container runs as uid 1000 (USER node) — so QEMU's open(O_RDWR)
# fails with EACCES and the VM refuses to start even though /dev/kvm is visible.
# Membership is fixed when the container is CREATED, so set this and RECREATE.
#
# Read the gid ON THE HOST (the container's groups come from the image, not the
# host, so a group NAME cannot be resolved for you):
#     stat -c %g /dev/kvm          # or: getent group kvm | cut -d: -f3
# then set it here and recreate:
#     docker compose -f compose.yaml -f compose.windows.yaml up -d --force-recreate
# Verify inside the container — the gid must appear in `id`'s group list:
#     docker compose exec seek-harness sh -c 'ls -l /dev/kvm; id'
#
# compose.emulator.yaml and compose.windows.yaml already pass
# `group_add: ["${KVM_GID:-kvm}"]`. Empty/unset falls back to the NAME `kvm`,
# which only matches by luck; a numeric gid is the reliable form.
#KVM_GID=107
# GPU: "virgl" makes virgl the DEFAULT for a create that does not ask (an
# explicit gpu:false still wins). Needs a WITH_VIRGL_QEMU=1 image and /dev/dri —
# compose.gpu.yaml sets this for you.
DSH_CUA_VM_GPU=
# Desktop geometry. Keep 1200x750: it is exactly cua's ~900k px capture budget, so
# a pixel read in the screenshot is the pixel clicked. A larger desktop is
# refused at create time unless you accept the scaled capture below.
DSH_CUA_VM_RESOLUTION=1200x750
# 1 = allow a desktop above the capture budget (image px ≠ display px, and every
# desktop result prints the ratio instead of hiding it).
DSH_CUA_VM_RESOLUTION_ALLOW_SCALE=
# 1 (default) = /workspace is a 9p mount inside the guest; 0 = only put/get copy.
DSH_CUA_VM_SHARE_WORKSPACE=1
# 1 = `cua_vm_stop` means suspend again (the pre-2026-11 alias). Default 0: stop
# is a real ACPI shutdown, a checkpoint, and a powered-off row.
DSH_CUA_VM_LEGACY_STOP=
# Windows computers: direct QEMU (OVMF + swtpm + qcow2 under /cua-vm), no Docker
# engine. Needs compose.windows.yaml for /dev/kvm (+ /dev/dri for the display).
#   1 = the kind exists · 0 (default) = the option is removed entirely
DSH_CUA_VM_WINDOWS=0
# Optional: a virtio-win ISO. Without it the disk is AHCI and the NIC is e1000e
# (stock Windows drivers); with it the guest gets virtio-blk/virtio-net.
#DSH_CUA_WINDOWS_VIRTIO_ISO=/cua-vm/iso/virtio-win.iso
# The unattended-answer payload (Autounattend.xml + setupcomplete.cmd +
# cua-firstboot.ps1). The image ships it at the default path; only set this if
# you mount your own copy, and keep the COMPLETE set of three files there.
# (`startup.nsh` — the EFI Shell fallback that chain-loads the install media if
# a key press is missed — is GENERATED into the stick by the supervisor, not
# sourced from here.)
#DSH_CUA_WINDOWS_OEM_DIR=/usr/local/share/cua-vm/windows-oem
# Colon-separated self-healing fallbacks tried when DSH_CUA_WINDOWS_OEM_DIR is
# missing files. The image default is /opt/seek-harness/cua-check (the flat gate
# tree, which carries the same three files). An empty string disables them.
#DSH_CUA_WINDOWS_OEM_FALLBACK_DIRS=/opt/seek-harness/cua-check
# The install CD's "Press any key to boot from CD or DVD" window (5 s). OVMF
# reaches cdboot, nobody presses a key, and the firmware drops into the EFI
# Internal Shell — a dead end for an unattended install. The supervisor presses
# Enter over QMP at these offsets (ms, comma-separated) ONLY while installing.
# Slow/fast firmware: widen or shift the list. 0 disables every press.
#DSH_CUA_WINDOWS_CDBOOT_KEYS_MS=1500,3500,5500
#DSH_CUA_WINDOWS_CDBOOT_KEYS=0
# How long OpenSSH may take AFTER the installed disk has booted (the serial log
# shows "Boot0004 Windows Boot Manager" from the HD). The 60-minute install
# window measures Setup; firstboot (OpenSSH, python, pip) gets this window
# measured from the boot, so a slow install is never marked `error` while its
# provisioning is still running. Default 15.
#DSH_CUA_WINDOWS_SSH_GRACE_MIN=15
# The guest installs a PINNED dsh-cua build: firstboot runs `pip install <this
# spec>`, and the D3 scale patch is hash-gated to 0.4.1 — a floating wheel is a
# build nobody verified. Override only to pin another build; the firstboot marker
# then records `scaleFix: "skipped:version-mismatch"` and the published desktop
# fact reads `skipped:anchor` — neither pretends the patch applied.
#DSH_CUA_WINDOWS_DSH_CUA=dsh-cua==0.4.1
# How long `cua_vm_exec`/`put`/`get` wait for a booting Windows computer's sshd
# (ms, retried 3000 ms apart). The give-up answer is `exit 125` + `code: booting`
# with a retry hint — never ssh's bare 255 and never "no guest agent".
#DSH_CUA_WINDOWS_SSH_WAIT_MS=60000
# The guest's dsh-cua MCP tools (element actions) attach lazily while a Windows
# computer is ready; 0 disables the path entirely.
DSH_CUA_VM_WIN_MCP=1
# 1 (default) = when the bridge is attached on the blind session-0 lane, the
# plugin may issue ONE self-contained repair SSH command per throttle window
# (schtasks re-assert + handshake, 60 s; 5 min after three failures) and then
# re-probe. 0 = no repair child is ever spawned: the doctor still says `blind`
# (its `repair` facts read `enabled: false`), which is the honest negative. The bridge
# and the reveal are unaffected — `DSH_CUA_VM_WIN_MCP=0` remains the switch that
# disables the whole path.
DSH_CUA_VM_WIN_MCP_REPAIR=1

# ── Clipboard bridge + Windows switches ──────────────────────────────
# 1 (default) = the noVNC live view is served by the built-in cua-vnc-clip
# bridge (static files + WebSocket + the RFB clipboard path) instead of
# websockify. It binds 127.0.0.1 only, needs no Python, and the caller falls
# back to websockify on its own if it cannot start. 0 = websockify.
DSH_CUA_VNC_CLIP=1
# How often that bridge reads the guest clipboard (ms). Lower makes a copy in
# the guest appear in noVNC sooner and asks the supervisor more often; 1200 is
# the default because a clipboard is not a real-time surface.
DSH_CUA_VNC_CLIP_POLL_MS=1200
# 1 (default) = firstboot registers `cua-clip-agent`, the in-session clipboard
# LOOP (the ambient path: copy something in Notepad and the harness sees it).
# 0 = only the on-demand `cua-clip-set` / `cua-clip-get` tasks.
DSH_CUA_CLIP_AGENT=1
# 1 (default) = allow the legacy BIOS (SeaBIOS) boot path for a Windows install
# when OVMF is unavailable or an image only boots that way. 0 = UEFI only, and
# a machine that cannot boot UEFI fails with a clear message instead of quietly
# changing firmware.
DSH_CUA_WIN_LEGACY_BIOS=1
# How often the guest's dsh-cua MCP state is re-read (ms) while a Windows
# computer is being driven; 10000 keeps a ready machine quiet between actions.
DSH_CUA_MCP_STATE_POLL_MS=10000
# 1 (default) = check a Windows ISO against its published SHA-256 before a ~5.5
# GB install is allowed to start. 0 downloads and trusts it: faster, and it
# gives up the only evidence that the media is the one that was asked for.
DSH_CUA_WIN_ISO_SHA256=1

# ── MCP relay wedge watchdog, desktop-facts cadence, per-call budget ──
# How long ONE guest MCP request may stay outstanding before the relay declares
# the child WEDGED: it kills that child (TerminateProcess), answers every pending
# id with `child-wedged: ... its effect is UNKNOWN`, and restarts on the next
# frame. 20000 sits UNDER the host's 25000 per-call budget on purpose — the guest
# clock starts later, so the guest's answer must be able to arrive first. 0
# disables the watchdog (the old behaviour: the call waits forever).
DSH_CUA_MCP_WEDGE_DEADLINE_MS=20000
# How often the desktop facts file is re-measured while ANY fact (element lane,
# work dir, scale) is not true. 60000 is the suspect cadence: a guest that is
# half-working is the one worth re-measuring, and 60 s is cheap next to the
# 20 s functional probe it saves.
DSH_CUA_MCP_FACTS_REFRESH_MS=60000
# How often the same file is re-measured once EVERY fact is true (900000 = 15
# min). A healthy desktop does not change on its own, and this is the cadence
# that keeps a quiet Windows computer quiet.
DSH_CUA_MCP_FACTS_FULL_REFRESH_MS=900000
# The HOST's per-request transport budget inside a guest tool call (ms).
# Envelope = this + 1 s, the retry budget = 2 envelopes + 4 s, the registered
# ceiling = envelope + 4 s, all derived from this one number so a test can scale
# the whole ladder with one variable. It is NOT the attach budget: the 45 s
# handshake keeps its own constant.
DSH_CUA_WIN_MCP_CALL_TIMEOUT_MS=25000
