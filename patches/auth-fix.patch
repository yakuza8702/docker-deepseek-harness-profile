+// @vitest-environment jsdom
+/** The registered settings surface reports an unreachable account and recovers through its retry action. */
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import type { AccountView } from '@deepseek-ai/dsh-deepseek-account/types'
+import type { GlobalStandardProps } from '@deepseek-ai/dsh-client-ui-slots'
+import type { ThemeSnapshot } from '@deepseek-ai/dsh-client-ui-theme/client'
+import { AccountSection, type AccountSectionInjected, type AccountSnapshot } from '../src/client/AccountSection.tsx'
+import { apply } from '../src/client/index.ts'
+import { en, type AccountKey } from '../src/client/locales.ts'
+
+afterEach(() => { cleanup(); vi.unstubAllEnvs() })
+
+type AccessEffect = (() => void) | Iterable<() => void>
+
+interface Guard {
+  install: () => AccessEffect
+  installed: (() => void)[] | undefined
+}
+
+/**
+ * Install every guard's current effect.
+ * @param guards - Guards registering this run's access controllers.
+ */
+function grant(guards: readonly Guard[]): void {
+  for (const guard of guards) {
+    const effect = guard.install()
+    guard.installed = typeof effect === 'function' ? [effect] : [...effect]
+  }
+}
+
+/**
+ * Dispose every installed effect in reverse install order.
+ * @param guards - Guards registering this run's access controllers.
+ */
+function revoke(guards: readonly Guard[]): void {
+  for (const guard of [...guards].reverse()) {
+    for (const dispose of (guard.installed ?? []).reverse()) dispose()
+    guard.installed = undefined
+  }
+}
+
+const theme: ThemeSnapshot = {
+  preference: 'light', fontSizes: { text: 14, code: 11, terminal: 13 }, fontFamilies: { text: '', code: '', terminal: '' },
+  active: { id: 'light', colorScheme: 'light', tokens: {} }, themes: [], revision: 0,
+}
+
+const links = { usageUrl: 'https://example.test/usage', topUpUrl: 'https://example.test/top_up' }
+const signedOut: AccountView = { status: 'signed-out', attempt: null, links }
+
+/**
+ * The account plugin over hand-built services whose account stream never delivers a frame.
+ * @param getState - the state read the retry action performs.
+ * @returns the plugin's access guards, the registered component and its inject face, and teardown.
+ */
+function unreachableHarness(getState: () => Promise<{ ok: true; value: AccountView }>) {
+  const guards: Guard[] = []
+  const lifetime: (() => void)[] = []
+  const getProfile = vi.fn(async () => ({ ok: true as const, value: null }))
+  let operations: AccountSectionInjected | undefined
+  let registered: unknown
+  const ctx = {
+    on: () => () => {}, provide: () => {}, emit: () => {}, parallel: async () => [],
+    effect: (install: () => (() => void) | undefined) => { const dispose = install(); if (dispose) lifetime.push(dispose) },
+    locale: { register: () => () => {}, bind: () => (key: string) => key, getSnapshot: () => ({ active: 'en' }) },
+    configForms: {
+      get: () => ({ subscribe: () => () => {}, getSnapshot: () => ({ status: 'loading', value: undefined }) }),
+      describe: () => ({ subscribe: () => () => {}, getSnapshot: () => ({ error: null }) }),
+    },
+    theme: { getTheme: () => theme, getSnapshot: () => theme, subscribe: () => () => {} },
+    slots: {
+      inject: (_name: string, install: () => (() => void) | undefined) => {
+        const dispose = install()
+        return () => { dispose?.() }
+      },
+      register: (entry: { readonly name: string; readonly inject?: () => AccountSectionInjected }, component: unknown) => {
+        if (entry.name === 'settings.section') {
+          operations = entry.inject?.()
+          registered = component
+        }
+        return () => {}
+      },
+    },
+    remoteAccess: {
+      whenAccess: (_action: string, install: () => AccessEffect) => {
+        guards.push({ install, installed: undefined })
+        return () => {}
+      },
+    },
+    remote: {
+      $on: () => () => {},
+      session: { initializeDefaultModel: async () => ({ ok: true, value: undefined }) },
+      account: { getState, getProfile, getBalance: async () => ({ ok: true, value: null }) },
+      $stream: () => {
+        const abort = new AbortController()
+        return {
+          signal: abort.signal,
+          dispose: () => { abort.abort() },
+          async *[Symbol.asyncIterator]() {
+            // A carrier that never delivers: the plugin's frame loop fails and reports the stream failure.
+            throw new Error('carrier down')
+          },
+        }
+      },
+    },
+  }
+  apply(ctx as never)
+  return {
+    guards,
+    operations: () => operations!,
+    registered: () => registered,
+    getProfile,
+    dispose: () => { revoke(guards); for (const dispose of lifetime.reverse()) dispose() },
+  }
+}
+
+/** Props the settings slot supplies to the registered section. */
+function sectionProps(operations: AccountSectionInjected) {
+  const useAccount = <T,>(select: (value: AccountSnapshot) => T): T => select(operations.hooks.account.getSnapshot())
+  return {
+    ...({} as GlobalStandardProps),
+    ...operations,
+    useAccount,
+    useTheme: <T,>(select: (value: ThemeSnapshot) => T): T => select(theme),
+    close: () => {},
+    t: (key: string) => en[key as AccountKey],
+  }
+}
+
+it('shows the unreachable card for a stream that never delivers and recovers through its retry', async () => {
+  vi.stubEnv('DSH_CLIENT_VERSION', '0.0.0-test')
+  const getState = vi.fn(async () => ({ ok: true as const, value: signedOut }))
+  const h = unreachableHarness(getState)
+  try {
+    grant(h.guards)
+    await act(async () => { await new Promise(resolve => setTimeout(resolve, 0)) })
+    // The failed carrier leaves the state unknown, and the plugin still registers the account section.
+    expect(h.operations().hooks.account.getSnapshot()).toMatchObject({ view: undefined, failed: true })
+    expect(h.registered()).toBe(AccountSection)
+    render(<AccountSection {...sectionProps(h.operations())} />)
+    expect(screen.getByText(en.accountUnreachableTitle)).toBeTruthy()
+    expect(screen.getByRole('status').textContent).toBe(en.accountUnreachable)
+    expect(screen.queryByRole('button', { name: en.signIn })).toBeNull()
+    await act(async () => { fireEvent.click(screen.getByRole('button', { name: en.retryAccount })) })
+    expect(getState).toHaveBeenCalledOnce()
+    // The re-read restored the real state, so the card offers a fresh sign-in instead.
+    expect(screen.getByText(en.settingsSignedOutTitle)).toBeTruthy()
+    expect(screen.getByRole('button', { name: en.signIn })).toBeTruthy()
+  } finally { h.dispose() }
+})
+
+it('never publishes a retry result or starts a read for a revoked grant', async () => {
+  vi.stubEnv('DSH_CLIENT_VERSION', '0.0.0-test')
+  const pending = Promise.withResolvers<{ ok: true; value: AccountView }>()
+  const getState = vi.fn(async () => await pending.promise)
+  const h = unreachableHarness(getState)
+  try {
+    grant(h.guards)
+    await act(async () => { await new Promise(resolve => setTimeout(resolve, 0)) })
+    // A revoked grant owns no surfaces: the retry starts no state read at all.
+    revoke(h.guards)
+    await h.operations().retryAccount()
+    expect(getState).not.toHaveBeenCalled()
+
+    grant(h.guards)
+    await act(async () => { await new Promise(resolve => setTimeout(resolve, 0)) })
+    const retrying = h.operations().retryAccount()
+    expect(getState).toHaveBeenCalledOnce()
+    // The read outlives the grant it was started under, so its result is dropped with the reads it would start.
+    revoke(h.guards)
+    pending.resolve({ ok: true, value: signedOut })
+    await retrying
+    expect(h.operations().hooks.account.getSnapshot()).toMatchObject({ view: undefined })
+    expect(h.getProfile).not.toHaveBeenCalled()
+  } finally { h.dispose() }
+})
